{
  "name": "lore-clone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:api\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "api": "tsx watch server/api.ts",
    "serve": "concurrently -k -n api,web \"tsx server/api.ts\" \"vite preview --host 127.0.0.1\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
