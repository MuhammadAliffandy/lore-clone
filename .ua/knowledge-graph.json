  "tour": [
    {
      "order": 1,
      "title": "Tujuan dan cara menjalankan",
      "description": "Mulai dari README untuk melihat fitur yang sudah tersedia dan batas implementasi clone ini. Dokumen itu juga menunjukkan cara menjalankan UI dan API lokal, jadi kita punya peta sebelum masuk ke source code.",
      "nodeIds": [
        "document:README.md",
        "config:package.json"
      ]
    },
    {
      "order": 2,
      "title": "Entry point aplikasi",
      "description": "Dari konfigurasi proyek, masuk ke entry point React yang memasang App serta stylesheet ke halaman. App menjadi pengatur alur onboarding, Today, Explore, Saved, profil, dan reader; di sini juga UI berhubungan dengan API lokal dan fallback browser.",
      "nodeIds": [
        "file:src/main.tsx",
        "file:src/App.tsx"
      ],
      "languageLesson": "React hooks seperti useState, useReducer, useEffect, dan useMemo menyimpan state, merespons perubahan, dan menghindari komputasi ulang yang tidak diperlukan."
    },
    {
      "order": 3,
      "title": "Pengalaman di layar HP",
      "description": "App merangkai onboarding minat, kartu cerita, reader, koleksi, dan navigasi bawah sebagai satu pengalaman. Stylesheet mengubah rail desktop menjadi navigasi bawah, menjaga area aman perangkat, dan mengatur ulang grid untuk viewport sempit—ini penting karena penggunaan ponsel adalah prioritas desain clone.",
      "nodeIds": [
        "file:src/App.tsx",
        "file:src/app.css"
      ]
    },
    {
      "order": 4,
      "title": "Cerita dan progres",
      "description": "Model domain mendefinisikan Story, topik, aksi pembaca, tanggal selesai, dan streak; reducer adalah satu tempat untuk menerapkan perubahan like, save, skip, atau selesai. Penyimpanan browser memulihkan state saat halaman dibuka lagi, sedangkan katalog menyediakan empat cerita kurasi awal dengan sumber dan metadata masing-masing.",
      "nodeIds": [
        "file:src/core/story.ts",
        "function:src/core/story.ts:reduceReaderState",
        "file:src/core/persistence.ts",
        "file:src/content/stories.ts"
      ]
    },
    {
      "order": 5,
      "title": "Urutan feed harian",
      "description": "Ranker lokal menyusun cerita berdasarkan minat dan aktivitas seperti selesai, skip, like, dan save, lalu App menggunakan urutan itu untuk feed. Ini pilihan algoritma clone yang sederhana dan dapat diperiksa; riset tidak menemukan rumus internal ranking Lore yang bisa dibuktikan.",
      "nodeIds": [
        "file:src/core/rankFeed.ts",
        "function:src/core/rankFeed.ts:rankFeed",
